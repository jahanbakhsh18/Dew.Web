@model Dew.Common.DashboardPageModel
@inject ITextLocalizer Localizer
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageId"] = "Dashboard";
}

@section Head {
@Html.StyleBundle("Pages/Dashboard")
@Html.ScriptBundle("Pages/Dashboard")
}

@section ContentHeader {
    <h1>@Localizer.Get("Navigation.Dashboard")</h1>
}

<div class="row">
    <div class="col-lg-3 col-sm-6">
        <div class="card s-dashboard-card-sm bg-opacity-50 bg-primary">
            <div class="card-body">
                <h3>@Model.OpenTickets</h3>
                <p>Open Tickets</p>
            </div>
            <div class="icon"><i class="fa fa-ticket"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card s-dashboard-card-sm bg-opacity-50 bg-info">
            <div class="card-body">
                <h3>@Model.ClosedTicketPercent<sup style="font-size:20px">%</sup></h3>
                <p>Closed Tickets</p>
            </div>
            <div class="icon"><i class="fa fa-check-circle"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card s-dashboard-card-sm bg-opacity-50 bg-warning">
            <div class="card-body">
                <h3>@Model.SystemCount</h3>
                <p>Systems</p>
            </div>
            <div class="icon"><i class="fa fa-object-ungroup"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="card s-dashboard-card-sm bg-opacity-50 bg-success">
            <div class="card-body">
                <h3>@Model.ProblemCount</h3>
                <p>Problem Types</p>
            </div>
            <div class="icon"><i class="fa fa-warning"></i></div>
        </div>
    </div>
</div>

<div class="row">
    <section class="col-lg-4">
        <div class="card s-dashboard-card">
            <div class="card-header"><h3 class="card-title">Tickets by Status</h3></div>
            <div class="card-body">
                <canvas id="status-chart" style="height:240px"></canvas>
            </div>
        </div>
    </section>
    <section class="col-lg-8">
        <div class="card s-dashboard-card">
            <div class="card-header"><h3 class="card-title">Tickets by System</h3></div>
            <div class="card-body">
                <canvas id="system-chart" style="height:240px"></canvas>
            </div>
        </div>
    </section>
</div>

<div class="row">
    <section class="col-lg-8">
        <div class="card s-dashboard-card">
            <div class="card-header"><h3 class="card-title">New Tickets (last 14 days)</h3></div>
            <div class="card-body">
                <canvas id="trend-chart" style="height:260px"></canvas>
            </div>
        </div>
    </section>
    <section class="col-lg-4">
        <div class="card s-dashboard-card">
            <div class="card-header"><h3 class="card-title">Time Flags</h3></div>
            <div class="card-body">
                @foreach (var tf in Model.TicketsByTimeFlag)
                {
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-flag me-2" style="color:@tf.Color"></i>
                        <span class="flex-grow-1">@tf.Name</span>
                        <strong>@tf.Count</strong>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

<script nonce="@Html.CspNonce()">
    (function () {
        var statusData = @Html.Raw(Serenity.JSON.Stringify(Model.TicketsByStatus));
        var systemData = @Html.Raw(Serenity.JSON.Stringify(Model.TicketsBySystem));
        var trendData = @Html.Raw(Serenity.JSON.Stringify(Model.TicketsLast14Days));

        var scaleGrid = { color: 'rgba(140, 142, 150, 0.15)', borderDash: [8, 4] };
        var tickColor = { color: 'rgb(140, 142, 150)' };

        new Chart(document.getElementById('status-chart'), {
            type: 'doughnut',
            data: {
                labels: statusData.map(function (x) { return x.StatusName; }),
                datasets: [{
                    data: statusData.map(function (x) { return x.Count; }),
                    backgroundColor: ['#4dc9f6', '#f67019', '#f53794', '#537bc4', '#acc236', '#166a8f']
                }]
            },
            options: { responsive: false, maintainAspectRatio: false }
        });

        new Chart(document.getElementById('system-chart'), {
            type: 'bar',
            data: {
                labels: systemData.map(function (x) { return x.Name; }),
                datasets: [{
                    label: 'Tickets',
                    data: systemData.map(function (x) { return x.Count; }),
                    backgroundColor: '#206bc4'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { ticks: tickColor, grid: { display: false } }, y: { ticks: tickColor, grid: scaleGrid } }
            }
        });

        new Chart(document.getElementById('trend-chart'), {
            type: 'line',
            data: {
                labels: trendData.map(function (x) { return x.Date; }),
                datasets: [{
                    label: 'New tickets',
                    data: trendData.map(function (x) { return x.Count; }),
                    borderColor: '#39a0ff',
                    backgroundColor: 'rgba(57,160,255,0.15)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { x: { ticks: tickColor, grid: { display: false } }, y: { ticks: tickColor, grid: scaleGrid } }
            }
        });
    })();
</script>